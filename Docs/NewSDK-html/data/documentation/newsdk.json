{"variants":[{"paths":["\/documentation\/newsdk"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Framework","title":"NewSDK","symbolKind":"module","role":"collection","externalID":"NewSDK","modules":[{"name":"NewSDK"}]},"hierarchy":{"paths":[[]]},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Scan a Moroccan national ID card (CIN) on the device and get the extracted identity data back.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"NewSDK presents a ready-made, full-screen scanner. A scan has two steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Recto","type":"text"}]},{"type":"text","text":" – the front of the card is detected and its fields are read with on-device OCR."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Verso","type":"text"}],"type":"strong"},{"text":" – the back of the card (parents, address, sex…).","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the verso is confirmed, the scanner closes and the data and both card images are handed to your code."}]},{"type":"paragraph","inlineContent":[{"text":"The new CIN and the old CIN layouts are both supported. Card detection runs with TensorFlow Lite and text and face","type":"text"},{"text":" ","type":"text"},{"text":"recognition with Google ML Kit, all on the device. The screens are localized in English and French.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import NewSDK","","let scanner = NewSDKScanner.makeNewCinScanner { result in","    guard let result else { return }","    print(result.cin ?? \"\", result.firstName ?? \"\", result.lastName ?? \"\")","}","present(scanner, animated: true)"]},{"type":"paragraph","inlineConte