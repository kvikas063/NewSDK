{"metadata":{"role":"article","title":"How a scan works","roleHeading":"Article","modules":[{"name":"NewSDK"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/newsdk\/scanflow"]}],"seeAlsoSections":[{"generated":true,"anchor":"How-a-scan-works","title":"How a scan works","identifiers":["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/BaseVC","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ViewControllerNewCin","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ViewControllerNewCinVerso","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ViewController","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/MainVideoViewController"]}],"abstract":[{"type":"text","text":"The screens that make up a scan, and how they hand over to each other."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/NewSDKScanner","type":"reference"},{"text":" creates the first screen of the flow and gives it your completion closure. Each screen passes the","type":"text"},{"text":" ","type":"text"},{"text":"closure on to the next one, so it is called once, at the very end.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"New CIN"}],"type":"strong"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ViewControllerNewCin"},{"type":"text","text":" – the front. The camera frames are analysed with ML Kit text recognition; the card fields"},{"type":"text","text":" "},{"type":"text","text":"are parsed from the recognised text blocks."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ViewControllerNewCinVerso","i