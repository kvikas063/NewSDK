{"metadata":{"externalID":"NewSDK","title":"NewSDK","roleHeading":"Framework","modules":[{"name":"NewSDK"}],"role":"collection","symbolKind":"module"},"variants":[{"paths":["\/documentation\/newsdk"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Scan a Moroccan national ID card (CIN) on the device and get the extracted identity data back.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"NewSDK presents a ready-made, full-screen scanner. A scan has two steps:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Recto"}],"type":"strong"},{"type":"text","text":" – the front of the card is detected and its fields are read with on-device OCR."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Verso"}],"type":"strong"},{"type":"text","text":" – the back of the card (parents, address, sex…)."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"When the verso is confirmed, the scanner closes and the data and both card images are handed to your code.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The new CIN and the old CIN layouts are both supported. Card detection runs with TensorFlow Lite and text and face","type":"text"},{"text":" ","type":"text"},{"text":"recognition with Google ML Kit, all on the device. The screens are localized in English and French.","type":"text"}],"type":"paragraph"},{"code":["import NewSDK","","let scanner = NewSDKScanner.makeNewCinScanner { result in","    guard let result else { return }","    print(result.cin ?? \"\", result.firstName ?? \"\", result.lastName ?? \"\")","}","present(scanner, animated: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The SDK is a Swift package for iOS 15 and later. It has no Firebase dependency.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/GettingStarted","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/HostAppSetup","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/NewSDKScanner"],"title":"Essentials"},{"anchor":"Reading-the-outcome","identifiers":["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ReadingTheResult","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/KycResultViewModel","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/CinType"],"title":"Reading the outcome"},{"anchor":"How-a-scan-works","identifiers":["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ScanFlow","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/BaseVC","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ViewControllerNewCin","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ViewControllerNewCinVerso","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/ViewController","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/MainVideoViewController"],"title":"How a scan works"},{"anchor":"Localization-and-troubleshooting","identifiers":["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/Localization","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/Troubleshooting"],"title":"Localization and troubleshooting"},{"anchor":"Scan-session-state","identifiers":["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/fKrUHvHJknyK3g7L2vSipDnasRUh8RKV"],"title":"Scan session state"},{"anchor":"Device-enums-and-helpers","identifiers":["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/DeviceModel","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/SelfieAssistance","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/Utils","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/VideoCapture","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/VideoCaptureDelegate","doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/FaceDetectionView","