{"metadata":{"modules":[{"name":"NewSDK"}],"roleHeading":"Article","title":"Localization","role":"article"},"abstract":[{"type":"text","text":"The SDK is localized in English and French and follows the language of the host app."}],"kind":"article","variants":[{"paths":["\/documentation\/newsdk\/localization"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"All messages use short keys of the form ","type":"text"},{"code":"<group>.<name>","type":"codeVoice"},{"text":", for example ","type":"text"},{"code":"common.cancel","type":"codeVoice"},{"text":", ","type":"text"},{"code":"alert.useOriginalCin","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"face.hintBlink","type":"codeVoice"},{"text":". They are looked up with ","type":"text"},{"code":"\"key\".sdkLocalized","type":"codeVoice"},{"text":" and translated in","type":"text"},{"text":" ","type":"text"},{"code":"NewSDK\/Resources\/en.lproj\/NewSDKLocalizable.strings","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fr.lproj\/NewSDKLocalizable.strings","type":"codeVoice"},{"text":" (inside the SDK’s own","type":"text"},{"text":" ","type":"text"},{"text":"resource bundle). A language other than French falls back to English.","type":"text"}]},{"text":"Changing the language","level":3,"type":"heading","anchor":"Changing-the-language"},{"type":"paragraph","inlineContent":[{"text":"The SDK has no language setting of its own; it uses the language of the host app:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"On the device: ","type":"text"},{"inlineContent":[{"text":"Settings ▸ General ▸ Language & Region","type":"text"}],"type":"emphasis"},{"text":", or ","type":"text"},{"inlineContent":[{"text":"Settings ▸ [your app] ▸ Language","type":"text"}],"type":"emphasis"},{"text":" to change one app.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The host app must declare the language: add ","type":"text"},{"code":"fr","type":"codeVoice"},{"text":" to the project’s ","type":"text"},{"inlineContent":[{"text":"Localizations","type":"text"}],"type":"strong"},{"text":" or ","type":"text"},{"code":"CFBundleLocalizations","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"Info.plist. Without it the SDK stays in English on a French phone.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When testing: ","type":"text"},{"inlineContent":[{"type":"text","text":"Edit Scheme ▸ Run ▸ Options ▸ App Language"}],"type":"emphasis"},{"text":", or launch with","type":"text"},{"text":" ","type":"text"},{"code":"-AppleLanguages \"(fr)\" -AppleLocale fr_FR","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"text":"Adding or changing a message","level":3,"type":"heading","anchor":"Adding-or-changing-a-message"},{"type":"paragraph","inlineContent":[{"text":"Add the key to both ","type":"text"},{"code":".strings","type":"codeVoice"},{"text":" files and use ","type":"text"},{"code":"\"group.name\".sdkLocalized","type":"codeVoice"},{"text":" in code. Unit tests fail if a key used in","type":"text"},{"text":" ","type":"text"},{"text":"code is missing from a table, if a table has an unused key, or if a key is not a short ","type":"text"},{"code":"<group>.<name>","type":"codeVoice"},{"text":" identifier.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/Localization","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Localization and troubleshooting","generated":true,"anchor":"Localization-and-troubleshooting","identifiers":["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK\/Troubleshooting"]}],"hierarchy":{"paths":[["doc:\/\/newsdk-public.NewSDK\/documentation\/NewSDK"]]},"schemaVersion":{"ma